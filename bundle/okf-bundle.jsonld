e-gov.github.io/okf-ai-infrastructure/id/standards/opa"}],"route":"glossary/policy-as-code.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/policy-as-code.md"},"status":"stable","title":"Policy-as-code","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/prompt-injection","@type":"okf:Concept","description":"Malicious instructions hidden in tool descriptions or retrieved content.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/document/themes/failure-taxonomy"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/least-privilege"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/standards/mcp"}],"route":"glossary/prompt-injection.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/prompt-injection.md"},"status":"stable","title":"Prompt injection","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/provenance","@type":"okf:Concept","description":"The recorded entities, activities and agents that produced an outcome.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/audit-trail"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/consent"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/stack/observability-and-provenance"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/standards/w3c-prov"}],"route":"glossary/provenance.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/provenance.md"},"status":"stable","title":"Provenance","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/schema-grounding","@type":"okf:Concept","description":"Checking that fields and types match a formal contract."