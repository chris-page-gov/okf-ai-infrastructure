tructure/id/standards/openapi"}],"route":"glossary/api-gateway.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/api-gateway.md"},"status":"stable","title":"API gateway","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/attestation","@type":"okf:Concept","description":"Cryptographic proof of a workload's or node's identity/integrity.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/federated/trusted-execution-environments"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/workload-identity"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/standards/spiffe-spire"}],"route":"glossary/attestation.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/attestation.md"},"status":"stable","title":"Attestation","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/audit-trail","@type":"okf:Concept","description":"A trustworthy record of what an agent read, decided and did.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/consent"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/provenance"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/stack/observability-and-provenance"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/uk-government/atrs"}],"route":"glossary/audit-trail.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/audit-trail.md"},"status":"stable","title":"Audit trail","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/bearer-token","@type":"okf:Concept","description":"A credential where mere possession grants access.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/sender-constrained-token"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/workload-identity"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/standards/oauth-2-0"}],"route":"glossary/bearer-token.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/bearer-token.md"},"status":"stable","title":"Bearer token","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/compensation","@type":"okf:Concept","description":"Undoing or offsetting a completed step in a multi-step workflow.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/idempotency"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/stack/execution-and-orchestration"}],"route":"glossary/compensation.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/compensation.md"},"status":"stable","title":"Compensation","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/confused-deputy","@type":"okf:Concept","description":"A privileged component tricked into misusing its authority for another.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/least-privilege"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/stack/identity-and-authorisation"}],"route":"glossary/confused-deputy.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/confused-deputy.md"},"status":"stable","title":"Confused deputy","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/consent","@type":"okf:Concept","description":"Explicit user permission for data exposure or action.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/audit-trail"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/provenance"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/stack/observability-and-provenance"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/standards/mcp"}],"route":"glossary/consent.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/consent.md"},"status":"stable","title":"Consent","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/function-calling","@type":"okf:Concept","description":"A model emitting a tool invocation against a declared function schema.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/api-calling"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/structured-output"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/tool-use"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/organisations/openai"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/standards/structured-outputs"}],"route":"glossary/function-calling.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/function-calling.md"},"status":"stable","title":"Function calling","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/idempotency","@type":"okf:Concept","description":"An operation that can be safely repeated with the same effect.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/compensation"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/stack/execution-and-orchestration"}],"route":"glossary/idempotency.md","source_document":{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/glossary/idempotency.md"},"status":"stable","title":"Idempotency","type":"Glossary term"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/index","@type":"https://chris-page-gov.github.io/okf-explorer/ns#Index","description":"Plain-English definitions of the technical terms used across the bundle.","http://purl.org/dc/terms/references":[{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/agent-card"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/agent-skill"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/api-calling"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/api-gateway"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/attestation"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/audit-trail"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/bearer-token"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/compensation"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/confused-deputy"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/consent"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/function-calling"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/idempotency"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/least-privilege"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/policy-as-code"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/prompt-injection"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/provenance"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/schema-grounding"},{"@id":"https://chris-page-gov.github.io/okf-ai-infrastructure/id/glossary/semantic-grounding"},{"@id":"https://chri