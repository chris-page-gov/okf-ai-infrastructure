  "planes": [
    {
      "id": "source",
      "depends_on": [],
      "paths": [
        "*.md",
        "document/*",
        "federated/*",
        "frameworks/*",
        "glossary/*",
        "organisations/*",
        "research/*",
        "stack/*",
        "standards/*",
        "uk-government/*",
        "okf.config.json"
      ],
      "command_ids": [
        "check-migration"
      ]
    },
    {
      "id": "semantic",
      "depends_on": [
        "source"
      ],
      "paths": [
        "okf.semantic.json",
        "bundle/okf-bundle.yamlld",
        "bundle/okf-bundle.jsonld"
      ],
      "command_ids": [
        "build-runtime",
        "build-publication",
        "check-runtime",
        "check-publication"
      ]
    },
    {
      "id": "runtime",
      "depends_on": [
        "semantic"
      ],
      "paths": [
        "okf-bundle.json",
        "bundle/okf-bundle.json",
        "bundle/relationships.json"
      ],
      "command_ids": [
        "build-runtime",
        "build-publication",
        "check-runtime",
        "check-viewer",
        "check-publication"
      ]
    },
    {
      "id": "documentation",
      "depends_on": [
        "source",
        "semantic"
      ],
      "paths": [
        "README.md",
        "AGENTS.md",
        "CHANGELOG.md"
      ],
      "command_ids": [
        "check-language",
        "check-contract"
      ]
    },
    {
      "id": "release",
      "depends_on": [
        "semantic",
        "runtime",
        "documentation"
      ],
      "paths": [
        "bundle/semantic-validation.json",
        "bundle/checksums.json"
      ],
      "command_ids": [
        "check-publication",
        "test-all"
      ]
    },
    {
      "id": "deployment",
      "depends_on": [
        "release"
      ],
      "paths": [
        "bundle/index.html",
        ".github/workflows/pages.yml"
      ],
      "command_ids": [
        "check-publication",
        "verify-pages"
      ]
    }
  ],
  "tooling": {
    "commands": [
      {
        "id": "setup-environment",
        "kind": "setup",
        "planes": [
          "source"
        ],
        "command": "python3 -m venv .venv",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "external-state",
        "timeout_minutes": 5
      },
      {
        "id": "install-dependencies",
        "kind": "setup",
        "planes": [
          "source"
        ],
        "command": ".venv/bin/python -m pip install --requirement requirements-okf.lock",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "dependency-install",
        "mutates": "external-state",
        "timeout_minutes": 10
      },
      {
        "id": "build-runtime",
        "kind": "build",
        "planes": [
          "source",
          "semantic",
          "runtime"
        ],
        "command": ".venv/bin/python scripts/build_okf_bundle.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only",
        "timeout_minutes": 10
      },
      {
        "id": "build-publication",
        "kind": "build",
        "planes": [
          "semantic",
          "runtime",
          "release",
          "deployment"
        ],
        "command": ".venv/bin/python scripts/build_publication.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "generated-only",
        "timeout_minutes": 10
      },
      {
        "id": "check-migration",
        "kind": "check",
        "planes": [
          "source",
          "semantic"
        ],
        "command": ".venv/bin/python scripts/migrate_okf_v02.py --check",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 5
      },
      {
        "id": "check-runtime",
        "kind": "check",
        "planes": [
          "semantic",
          "runtime"
        ],
        "command": ".venv/bin/python scripts/build_okf_bundle.py --check",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "check-viewer",
        "kind": "check",
        "planes": [
          "runtime"
        ],
        "command": ".venv/bin/python scripts/update_viewer.py --check",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 5
      },
      {
        "id": "check-language",
        "kind": "check",
        "planes": [
          "documentation"
        ],
        "command": ".venv/bin/python scripts/check_british_english.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 5
      },
      {
        "id": "check-publication",
        "kind": "check",
        "planes": [
          "semantic",
          "runtime",
          "release",
          "deployment"
        ],
        "command": ".venv/bin/python scripts/check_publication.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 10
      },
      {
        "id": "check-contract",
        "kind": "check",
        "planes": [
          "source",
          "documentation",
          "release"
        ],
        "command": ".venv/bin/python scripts/check_publication_contract.py",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 5
      },
      {
        "id": "test-all",
        "kind": "test",
        "planes": [
          "source",
          "semantic",
          "runtime",
          "documentation",
          "release"
        ],
        "command": ".venv/bin/python -m unittest discover -s tests -v",
        "source": "AGENTS.md",
        "review_status": "reviewed-local-guidance",
        "network": "none",
        "mutates": "none",
        "timeout_minutes": 20
      },
      {
        "id": "verify-pages",
        "kind": "verify",
        "planes": [
          "deployment"
        ],
        "command": ".venv/bin/python scripts/verify_deployment.py",
        "source": ".github/workflows/pages.yml",
        "review_status": "reviewed-local-guidance",
        "network": "bounded-read",
        "mutates": "none",
        "timeout_minutes": 5
      }
    ]
  },
  "lockstep": {
    "controlled_paths": [
      "*.md",
      "document/*",
      "federated/*",
      "frameworks/*",
      "glossary/*",
      "organisations/*",
      "research/*",
      "stack/*",
      "standards/*",
      "uk-government/*",
