  "modified": "2026-08-18",
  "locale": "en-GB",
  "time_zone": "Europe/London",
  "repository": {
    "name": "okf-ai-infrastructure",
    "url": "https://github.com/chris-page-gov/okf-ai-infrastructure",
    "role": "small-bundle",
    "root_index": "index.md",
    "lifecycle": "active"
