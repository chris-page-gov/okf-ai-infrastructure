  },
  "source_families": [
    {
      "id": "markdown-corpus",
      "label": "AI infrastructure Markdown corpus",
      "description": "The reviewed Markdown concepts, navigation records and build configuration from which the semantic and static projections are generated.",
      "kind": "markdown-tree",
      "paths": [
        "index.md",
        "sources-index.md",
        "log.md",
        "document/*",
        "federated/*",
        "frameworks/*",
        "glossary/*",
        "organisations/*",
        "research/*",
        "stack/*",
        "standards/*",
        "uk-government/*",
        "okf.config.json"
      ],
      "formats": [
        "text/markdown",
        "application/json"
      ],
      "origin": "authored",
      "authority": "editorial",
      "snapshot_policy": "pinned-revision",
      "inventory": {
        "method": "pinned-source-register",
        "manifest_path": "okf.config.json",
        "identity": [
          "relative-path",
          "sha256",
          "source-version"
        ]
      },
      "rights": {
        "status": "approved",
        "evidence": [
          "https://github.com/chris-page-gov/okf-ai-infrastructure/blob/main/LICENSE.md"
        ]
      },
      "sensitivity": {
        "status": "public-no-personal-data",
        "assessment": "The repository publishes research and technical documentation intended for public access."
      },
      "extraction": {
        "mode": "deterministic-local",
        "network_access": "prohibited",
        "command_ids": [
          "build-runtime",
          "build-publication"
        ]
      },
      "invalidates": [
        "source",
        "semantic",
        "runtime",
        "documentation",
        "release",
        "deployment"
      ],
      "limitations": [
        "Cited external sources retain their own authority and rights; inclusion in this editorial corpus does not upgrade either."
      ]
    }
  ],
