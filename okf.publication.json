      "tests/*",
      ".github/workflows/*",
      "requirements-okf.*",
      "okf.config.json",
      "okf.semantic.json",
      "okf.publication.json",
      "bundle/*",
      "okf-bundle.json"
    ],
    "documentation_paths": [
      "README.md",
      "AGENTS.md",
      "CHANGELOG.md"
    ],
    "changelog_path": "CHANGELOG.md",
    "check_command_id": "check-contract",
    "dependency_update_policy": "assess-release-bound-bytes-no-blanket-exemption",
    "unknown_path_policy": "fail-closed"
  },
  "ci": {
    "provider": "github-actions",
    "workflow_paths": [
      ".github/workflows/ci.yml",
      ".github/workflows/pages.yml"
    ],
    "impact_routing": "full-suite",
    "parallelism": "serial",
    "unknown_path_policy": "full-suite",
    "browser": {
      "ordinary": {
        "policy": "not-applicable",
        "engines": [],
        "command_ids": []
      },
      "cross_engine": {
        "policy": "not-applicable",
        "engines": [],
        "command_ids": [],
        "installation": {
          "policy": "none",
          "command_ids": []
        }
      }
    }
  },
  "publication": {
    "mode": "automatic-protected-main",
    "scope": "public-release",
    "authority": {
      "decision": "Protected main is the sole automatic publication authority after the complete repository validation contract passes.",
      "evidence_paths": [
        "README.md",
        ".github/branch-protection.json"
      ]
    },
    "candidate_policy": "promote-exact-assured-bytes-without-rebuild",
    "targets": [
      {
        "id": "github-pages",
        "kind": "github-pages",
        "workflow_path": ".github/workflows/pages.yml",
        "public_base_url": "https://chris-page-gov.github.io/okf-ai-infrastructure/",
        "exact_commit_required": true,
        "promote_without_rebuild": true
      }
    ]
  },
  "verification": {
    "required": false,
    "browser": "not-applicable",
    "exact_commit_required": true,
    "identity_checks": [
      "sha256",
      "descriptor",
      "route"
    ],
    "journeys": [
      {
        "id": "verify-published-bundle",
        "url": "https://chris-page-gov.github.io/okf-ai-infrastructure/",
        "expected_identity": "The deployed checksum manifest and selected identity routes are byte-for-byte equal to the validated commit.",
        "steps": [
          "Fetch the deployed checksum manifest without rebuilding.",
          "Compare the landing page, Explorer descriptor and semantic validation receipt with the checked-out candidate bytes."
        ]
      }
    ],
    "console_policy": "not-applicable",
    "command_ids": [
      "verify-pages"
    ]
  },
  "limitations": [
    "The post-deploy hook proves HTTP route and byte identity through the checksum manifest; this static bundle has no browser interaction or console assurance gate.",
    "The complete validation suite remains intentionally serial and fail-closed because all generated publication planes share the same Markdown source graph."
  ]
}
